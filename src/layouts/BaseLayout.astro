---
import MainHead from "@components/Common/MainHead.astro";
import Nav from "@components/Common/Nav.astro";
import Footer from "@components/Common/Footer.astro";
import {
  DEFAULT_LANG,
  getAlternatePaths,
  getLangFromPath,
} from "../utils/routing";
import { DEFAULT_IMAGE, getEntryJsonLd, getPersonJsonLd } from "../utils/seo";

export interface Props {
  title?: string | undefined;
  description?: string | undefined;
  entry?: any;
}

const { title, description, entry } = Astro.props;

const lang = getLangFromPath(Astro.url.pathname) ?? DEFAULT_LANG;
const alternates = await getAlternatePaths(Astro.url.pathname, entry);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const image: string | undefined = entry?.data.img || undefined;
const isHome = Astro.url.pathname === `/${lang}/`;
const jsonLd = entry
  ? getEntryJsonLd(entry, canonicalURL, lang, new URL(image ?? DEFAULT_IMAGE, Astro.site).href)
  : isHome
    ? getPersonJsonLd(Astro.site!)
    : [];
// hreflang only makes sense when the page actually has another language version
const hreflangs =
  Object.keys(alternates).length > 1
    ? [
        ...Object.entries(alternates),
        ["x-default", alternates[DEFAULT_LANG] ?? Object.values(alternates)[0]],
      ]
    : [];
---

<html lang={lang}>
  <head>
    <MainHead
      title={title}
      description={description}
      lang={lang}
      alternateLangs={Object.keys(alternates) as (keyof typeof alternates)[]}
      image={image}
      imageAlt={entry ? entry.data.img_alt || entry.data.title : undefined}
      article={entry ? { publishDate: entry.data.publishDate, tags: entry.data.tags } : undefined}
      jsonLd={jsonLd}
    />
    {
      hreflangs.map(([hreflang, path]) => (
        <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("language");
          const currentPath = window.location.pathname;

          if (currentPath === "/" || currentPath === "/index.html") {
            if (saved === "en") {
              window.location.href = "/en/";
            } else if (!saved) {
              const browserLang = navigator.language || navigator.userLanguage;
              if (browserLang && browserLang.startsWith("en")) {
                window.location.href = "/en/";
              }
            }
          }
        } catch (e) {
          console.error("Language detection failed", e);
        }
      })();
    </script>
    <script
      src="https://cdn.tempooanalytics.eu/analytics.js"
      data-site="antoniobermudez-blog-RZq3-A"
      data-key="N71Rfehcz5PGzekWKqf4wWX2GXNYhbbFwv1whFQR8Wo"></script>
  </head>

  <body>
    <div class="stack backgrounds">
      <Nav entry={entry} />
      <slot />
      <Footer />
    </div>

    <script>
      addEventListener("load", () =>
        document.documentElement.classList.add("loaded"),
      );
    </script>

    <script>
      import mermaid from "mermaid";
      mermaid.initialize({ startOnLoad: true, theme: "neutral" });
    </script>

    <style>
      :root {
        --_placeholder-bg: linear-gradient(transparent, transparent);
        --bg-image-main: url("/assets/backgrounds/bg-main-light-800w.webp");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-light.svg");
        --bg-image-subtle-1: var(--_placeholder-bg);
        --bg-image-subtle-2: var(--_placeholder-bg);
        --bg-image-footer: var(--_placeholder-bg);
        --bg-noise: var(--_placeholder-bg); /* lazy load noise texture */
        --bg-svg-blend-mode: overlay;
        --bg-blend-mode: darken;
        --bg-image-aspect-ratio: 2.25;
        --bg-scale: 1.68;
        --bg-aspect-ratio: calc(var(--bg-image-aspect-ratio) / var(--bg-scale));
        --bg-gradient-size: calc(var(--bg-scale) * 100%);
      }

      :root.theme-dark {
        --bg-image-main: url("/assets/backgrounds/bg-main-dark-800w.webp");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-dark.svg");
        --bg-svg-blend-mode: darken;
        --bg-blend-mode: lighten;
      }

      :root.loaded {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-800w.webp");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-800w.webp");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-light-800w.webp");
        --bg-noise: url("/assets/backgrounds/noise.webp");
      }
      :root.loaded.theme-dark {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-800w.webp");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-800w.webp");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-800w.webp");
        --bg-noise: url("/assets/backgrounds/noise.webp");
      }

      @media (min-width: 50em) {
        :root {
          --bg-scale: 1;
          --bg-image-main: url("/assets/backgrounds/bg-main-light-1440w.webp");
        }
        :root.theme-dark {
          --bg-image-main: url("/assets/backgrounds/bg-main-dark-1440w.webp");
        }

        :root.loaded {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-1440w.webp");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-1440w.webp");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-light-1440w.webp");
        }
        :root.loaded.theme-dark {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-1440w.webp");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-1440w.webp");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-1440w.webp");
        }
      }

      .backgrounds {
        min-height: 100%;
        isolation: isolate;
        background:
					/*noise*/
          var(--bg-noise) top center/220px repeat,
          /*footer*/ var(--bg-image-footer) bottom
            center/var(--bg-gradient-size) no-repeat,
          /*header1*/ var(--bg-image-main-curves) top
            center/var(--bg-gradient-size) no-repeat,
          /*header2*/ var(--bg-image-main) top center/var(--bg-gradient-size)
            no-repeat,
          /*base*/ var(--gray-999);
        background-blend-mode: /*noise*/
          overlay,
          /*footer*/ var(--bg-blend-mode),
          /*header1*/ var(--bg-svg-blend-mode),
          /*header2*/ normal,
          /*base*/ normal;
      }
      @media (forced-colors: active) {
        /* Deactivate custom backgrounds for high contrast users. */
        .backgrounds {
          background: none;
          background-blend-mode: none;
          --bg-gradient-size: none;
        }
      }
    </style>
  </body>
</html>
