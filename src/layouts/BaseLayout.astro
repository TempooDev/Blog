---
import MainHead from "@components/Common/MainHead.astro";
import Nav from "@components/Common/Nav.astro";
import Footer from "@components/Common/Footer.astro";
import ConsentBanner from "@components/Common/ConsentBanner.astro";
import {
  DEFAULT_LANG,
  findServicePage,
  getAlternatePaths,
  getLangFromPath,
} from "../utils/routing";
import { DEFAULT_IMAGE, getEntryJsonLd, getPersonJsonLd } from "../utils/seo";

export interface Props {
  title?: string | undefined;
  description?: string | undefined;
  entry?: any;
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, entry, noindex = false, jsonLd: pageJsonLd } = Astro.props;

const lang = getLangFromPath(Astro.url.pathname) ?? DEFAULT_LANG;
const alternates = await getAlternatePaths(Astro.url.pathname, entry);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Posts use their generated cover (src/pages/og); other entries keep their image from Directus.
const isPost = entry?.collection === "blog";
const image: string | undefined = isPost ? `/og/${entry.id}.png` : entry?.data.img || undefined;
const isHome = Astro.url.pathname === `/${lang}/`;
const jsonLd = pageJsonLd ?? (entry
  ? getEntryJsonLd(entry, canonicalURL, lang, new URL(image ?? DEFAULT_IMAGE, Astro.site).href)
  : isHome
    ? getPersonJsonLd(Astro.site!)
    : []);
// hreflang only makes sense when the page actually has another language version.
// Service pages always declare it: the English-only GDPR page keeps en + x-default.
const hreflangs =
  !noindex && (Object.keys(alternates).length > 1 || findServicePage(Astro.url.pathname))
    ? [
        ...Object.entries(alternates),
        ["x-default", alternates[DEFAULT_LANG] ?? Object.values(alternates)[0]],
      ]
    : [];
---

<html lang={lang}>
  <head>
    <MainHead
      title={title}
      description={description}
      lang={lang}
      alternateLangs={Object.keys(alternates) as (keyof typeof alternates)[]}
      image={image}
      imageAlt={entry ? (isPost ? entry.data.title : entry.data.img_alt || entry.data.title) : undefined}
      imageSize={isPost ? { width: 1600, height: 840 } : undefined}
      article={entry ? { publishDate: entry.data.publishDate, tags: entry.data.tags } : undefined}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    {
      hreflangs.map(([hreflang, path]) => (
        <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Antonio Bermúdez · Blog" href={`/${lang}/rss.xml`} />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("language");
          const currentPath = window.location.pathname;

          if (currentPath === "/" || currentPath === "/index.html") {
            if (saved === "en") {
              window.location.href = "/en/";
            } else if (!saved) {
              const browserLang = navigator.language || navigator.userLanguage;
              if (browserLang && browserLang.startsWith("en")) {
                window.location.href = "/en/";
              }
            }
          }
        } catch (e) {
          console.error("Language detection failed", e);
        }
      })();
    </script>
  </head>

  <body>
    <div class="stack page">
      <Nav
        lang={lang}
        alternates={alternates}
        fallbackSection={entry ? (entry.collection === "blog" ? "blog" : entry.collection) : undefined}
      />
      <slot />
      <Footer lang={lang} />
    </div>
    <ConsentBanner lang={lang} />

    <script>
      // Mermaid is large, so it is only downloaded on pages that have diagrams.
      if (document.querySelector(".mermaid")) {
        import("mermaid").then(({ default: mermaid }) => {
          // Sequence diagrams keep their natural size (wide ones scroll inside .mermaid
          // instead of shrinking until the text is unreadable); flowcharts still fit the
          // column. The theme follows the site theme.
          const dark = document.documentElement.classList.contains("theme-dark");
          mermaid.initialize({
            startOnLoad: false,
            theme: dark ? "dark" : "neutral",
            sequence: { useMaxWidth: false },
          });
          mermaid.run();
        });
      }
    </script>

    <style>
      .page {
        min-height: 100vh;
        background: var(--bg);
      }
    </style>
  </body>
</html>
