---
import type { Lang } from "../../utils/routing";
import { consentI18n } from "../../i18n/pages/legal";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = consentI18n[lang];
---

<div class="consent-banner" role="region" aria-label={t.label} hidden data-labels={JSON.stringify({ granted: t.granted, denied: t.denied })}>
  <p>{t.text}</p>
  <a class="more" href={`/${lang}/cookies/`}>{t.more}</a>
  <div class="actions">
    <button type="button" data-consent="denied">{t.reject}</button>
    <button type="button" data-consent="granted" class="primary">{t.accept}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "consent";
    var banner = document.querySelector(".consent-banner");
    var labels = JSON.parse(banner.dataset.labels);

    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }

    function loadAnalytics() {
      if (document.getElementById("tempoo-analytics")) return;
      var s = document.createElement("script");
      s.id = "tempoo-analytics";
      s.src = "https://cdn.tempooanalytics.eu/analytics.js";
      s.dataset.site = "antoniobermudez-blog-RZq3-A";
      s.dataset.key = "N71Rfehcz5PGzekWKqf4wWX2GXNYhbbFwv1whFQR8Wo";
      s.dataset.heatmaps = "true";
      document.head.appendChild(s);
    }

    // While the bar is visible the page gets that much extra room at the bottom,
    // so it never covers the end of the content.
    function reserveSpace() {
      var h = banner.hidden ? 0 : banner.offsetHeight + 24;
      document.documentElement.style.setProperty("--consent-space", h + "px");
    }
    if (window.ResizeObserver) new ResizeObserver(reserveSpace).observe(banner);

    function render(state) {
      banner.hidden = state === "granted" || state === "denied";
      reserveSpace();
      document.querySelectorAll("[data-consent-state]").forEach(function (el) {
        el.textContent = state ? labels[state] : "—";
      });
    }

    function set(state) {
      try {
        localStorage.setItem(KEY, state);
        if (state === "denied") {
          localStorage.removeItem("tempoo_visitor");
          sessionStorage.removeItem("tempoo_session");
        }
      } catch (e) {}
      // The Tempoo script can't be stopped once running, so withdrawing consent reloads without it.
      if (state === "denied" && document.getElementById("tempoo-analytics")) {
        location.reload();
        return;
      }
      render(state);
      if (state === "granted") loadAnalytics();
    }

    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-consent]");
      if (btn) set(btn.dataset.consent);
    });

    var state = read();
    render(state);
    if (state === "granted") loadAnalytics();
  })();
</script>

<style>
  :global(body) {
    padding-bottom: var(--consent-space, 0px);
  }

  /* Small dark bar at the bottom: a card on phones, one row on desktop. */
  .consent-banner {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 90;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: 1rem;
    border-radius: 8px;
    background: var(--board);
    color: var(--board-ink);
    font-size: 0.9375rem;
    line-height: 1.45;
    box-shadow: var(--shadow-lg);
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner p {
    grid-column: 1 / -1;
  }

  .more {
    grid-column: 1 / -1;
    justify-self: start;
    color: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: underline;
  }

  .actions {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .actions button {
    padding: 0.7rem 1rem 0.6rem;
    border-radius: 4px;
    border: 1.5px solid var(--board-ink);
    background: transparent;
    color: var(--board-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .actions .primary {
    border-color: var(--signal);
    background: var(--signal);
    color: #121212;
  }

  @media (min-width: 50em) {
    .consent-banner {
      bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      width: max-content;
      max-width: calc(100% - 3rem);
      padding: 0.875rem 1rem 0.875rem 1.25rem;
    }

    .more {
      white-space: nowrap;
    }

    .actions {
      display: flex;
      flex: none;
    }

    .actions button {
      padding: 0.55rem 1rem 0.45rem;
    }
  }
</style>
