---
import CallToAction from "@components/Common/CallToAction.astro";
import Icon from "@components/Common/Icon.astro";

interface Props {
  title: string;
  text: string;
  cta: string;
}

const { title, text, cta } = Astro.props;
---

<aside>
  <div class="copy">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <CallToAction
    href="https://citas.antoniobermudez.dev/"
    data-tempoo-goal="contacto_servicio"
    data-tempoo-goal-pagina={Astro.url.pathname}
  >
    {cta}
    <Icon icon="arrow-right" size="1.2em" />
  </CallToAction>
</aside>

<style>
  aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    border-top: 1px solid var(--gray-800);
    border-bottom: 1px solid var(--gray-800);
    padding: 5rem 1.5rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    color: var(--gray-200);
  }

  h2 {
    font-size: var(--text-xl);
  }

  /* Some CTA texts are long: let them wrap on phones instead of overflowing. */
  aside :global(a) {
    white-space: normal;
  }

  @media (min-width: 50em) {
    aside {
      padding: 7.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .copy {
      text-align: left;
    }

    h2 {
      font-size: var(--text-3xl);
    }
  }
</style>
