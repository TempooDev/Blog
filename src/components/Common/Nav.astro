---
import ThemeToggle from "@components/Common/ThemeToggle.astro";
import { navI18n } from "../../i18n/components";
import { LANGS, SERVICE_PAGES, type Lang } from "../../utils/routing";

interface Props {
  lang: Lang;
  /** URL of this page in each language (from getAlternatePaths). */
  alternates: Partial<Record<Lang, string>>;
  /** Section index to fall back to when this entry has no translation. */
  fallbackSection?: string | undefined;
}

const { lang, alternates, fallbackSection } = Astro.props;
const t = navI18n[lang];

const links = [
  { label: t.blog, href: `/${lang}/blog/` },
  { label: t.work, href: `/${lang}/work/` },
  { label: t.services, href: SERVICE_PAGES[0][lang]! },
  { label: t.newsletter, href: `/${lang}/newsletter/` },
  { label: t.about, href: `/${lang}/about/` },
];

let pathname = Astro.url.pathname;
if (!pathname.endsWith("/")) pathname += "/";
/** The section the page belongs to: the blog for a post, services for a service page… */
const isCurrent = (href: string) => pathname.startsWith(href);

const langHref = (l: Lang) =>
  alternates[l] ?? (fallbackSection ? `/${l}/${fallbackSection}/` : `/${l}/`);
---

<header class="site-header">
  <div class="bar wrapper">
    <a href={`/${lang}/`} class="brand">Antonio Bermúdez</a>

    <nav class="nav-desktop" aria-label={t.mainNav}>
      <ul>
        {
          links.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controls">
      <div class="lang" role="group" aria-label={t.language}>
        {
          LANGS.slice().reverse().map((l) => (
            <a
              href={langHref(l)}
              hreflang={l}
              lang={l}
              data-lang={l}
              aria-current={l === lang ? "true" : undefined}
              title={t.languageNames[l]}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <div class="theme-desktop"><ThemeToggle /></div>
      <a class="menu-open" href="#site-menu" aria-controls="site-menu" aria-expanded="false">
        <span class="sr-only">{t.openMenu}</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M3 6.5h18M3 12h18M3 17.5h18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile menu. Works without JS through :target; the script turns it into a toggle. -->
  <div id="site-menu" class="menu" aria-label={t.menu}>
    <div class="menu-bar">
      <a href={`/${lang}/`} class="brand">Antonio Bermúdez</a>
      <a class="menu-close" href="#">
        <span class="sr-only">{t.closeMenu}</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
        </svg>
      </a>
    </div>
    <div class="menu-body">
      <p class="kicker">{t.menu}</p>
      <ol class="menu-track">
        {
          links.map(({ label, href }, i) => (
            <li class:list={[{ current: isCurrent(href) }]}>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <span class="label">{label}</span>
                {isCurrent(href) && <span class="here">{t.here}</span>}
              </a>
            </li>
          ))
        }
      </ol>

      <div class="menu-row">
        <p class="kicker">{t.language}</p>
        <div class="lang lang-lg" role="group" aria-label={t.language}>
          {
            LANGS.slice().reverse().map((l) => (
              <a
                href={langHref(l)}
                hreflang={l}
                lang={l}
                data-lang={l}
                aria-current={l === lang ? "true" : undefined}
              >
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
        <ThemeToggle />
      </div>

      <a class="menu-newsletter" href={`/${lang}/newsletter/`}>
        <span class="kicker">{t.newsletterKicker}</span>
        <span class="cta">{t.newsletterCta} →</span>
      </a>

      <p class="menu-socials">
        <a href="https://github.com/TempooDev" rel="me">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/antoniobermudezr/" rel="me">LinkedIn ↗</a>
        <a href={`/${lang}/rss.xml`}>RSS</a>
      </p>
    </div>
  </div>
</header>

<script>
  // Remember the language the visitor picks (read by the root redirect in BaseLayout).
  document.querySelectorAll<HTMLAnchorElement>(".site-header [data-lang]").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("language", a.dataset.lang!);
      } catch {}
    }),
  );

  const menu = document.getElementById("site-menu")!;
  const opener = document.querySelector<HTMLAnchorElement>(".menu-open")!;
  const closer = menu.querySelector<HTMLAnchorElement>(".menu-close")!;

  const setOpen = (open: boolean) => {
    menu.classList.toggle("open", open);
    opener.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-locked", open);
    if (open) closer.focus();
    else opener.focus();
  };

  opener.addEventListener("click", (e) => {
    e.preventDefault();
    setOpen(true);
  });
  closer.addEventListener("click", (e) => {
    e.preventDefault();
    setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("open")) setOpen(false);
  });
  // Close it if the window grows past the mobile breakpoint.
  matchMedia("(min-width: 60em)").addEventListener("change", (e) => {
    if (e.matches && menu.classList.contains("open")) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--sep);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .brand {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-desktop {
    display: none;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-desktop {
    display: none;
  }

  /* ES / EN segmented control */
  .lang {
    display: inline-flex;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
  }

  .lang a {
    padding: 0.3rem 0.5rem 0.2rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  .lang a[aria-current] {
    background: var(--ink);
    color: var(--on-ink);
  }

  .lang a:not([aria-current]):hover {
    background: var(--accent-overlay);
  }

  .menu-open,
  .menu-close {
    display: inline-flex;
    padding: 0.5rem;
    margin-right: -0.5rem;
    color: var(--ink);
  }

  /* --- Mobile menu --------------------------------------------------------- */
  .menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    background: var(--bg);
  }

  .menu:target,
  .menu.open {
    display: block;
  }

  :global(html.menu-locked) {
    overflow: hidden;
  }

  .menu-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--sep);
  }

  .menu-body {
    padding: 1.75rem var(--gutter) 2.5rem;
  }

  .menu-track {
    --x: 1rem; /* center of the track */
    position: relative;
    list-style: none;
    padding: 1rem 0 0.25rem;
    margin: 0 0 2rem;
  }

  .menu-track::before {
    content: "";
    position: absolute;
    left: calc(var(--x) - var(--track) / 2);
    top: 1.5rem;
    bottom: 1.25rem;
    width: var(--track);
    border-radius: 4px;
    background: var(--ink);
  }

  .menu-track li {
    position: relative;
  }

  .menu-track li + li {
    margin-top: 1.5rem;
  }

  .menu-track li::before {
    content: "";
    position: absolute;
    left: calc(var(--x) - 10px);
    top: 1.35rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg);
    border: 4px solid var(--ink);
  }

  .menu-track li.current::before {
    left: calc(var(--x) - 13px);
    top: 1.15rem;
    width: 26px;
    height: 26px;
    box-shadow: 0 0 0 8px var(--accent-overlay);
  }

  .menu-track a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding-left: 3.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .menu-track .num {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  .menu-track .label {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .menu-track .current .label {
    font-weight: 700;
  }

  .menu-track .here {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .menu-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 2rem;
  }

  .menu-row .kicker {
    width: 100%;
  }

  .lang-lg a {
    padding: 0.55rem 1rem 0.45rem;
    font-size: 0.9375rem;
  }

  .menu-newsletter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 6px;
    background: var(--board);
    color: var(--board-ink);
    text-decoration: none;
  }

  .menu-newsletter .kicker {
    color: var(--signal);
    font-size: 0.6875rem;
  }

  .menu-newsletter .cta {
    font-weight: 700;
    font-size: 1.375rem;
  }

  .menu-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .menu-socials a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 60em) {
    .bar {
      min-height: 5rem;
    }

    .brand {
      font-size: 1.25rem;
    }

    .nav-desktop {
      display: block;
      margin-left: auto;
    }

    .nav-desktop ul {
      display: flex;
      gap: 2rem;
      list-style: none;
      padding: 0;
    }

    .nav-desktop a {
      position: relative;
      display: inline-block;
      padding-block: 0.5rem;
      color: var(--ink-2);
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-desktop a:hover {
      color: var(--ink);
    }

    /* Hover: a thin piece of track under the link */
    .nav-desktop a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.25rem;
      height: 3px;
      border-radius: 2px;
      background: var(--ink-2);
      opacity: 0;
      transition: opacity var(--theme-transition);
    }

    .nav-desktop a:hover::after {
      opacity: 1;
    }

    /* Current section: a station on a piece of track */
    .nav-desktop a[aria-current] {
      color: var(--ink);
      font-weight: 700;
    }

    .nav-desktop a[aria-current]::after {
      height: 4px;
      background: var(--ink);
      opacity: 1;
    }

    .nav-desktop a[aria-current]::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: calc(-0.25rem - 5px);
      width: 14px;
      height: 14px;
      margin-left: -7px;
      border-radius: 50%;
      border: 3px solid var(--ink);
      background: var(--bg);
      z-index: 1;
    }

    .controls {
      gap: 1rem;
    }

    .lang a {
      padding: 0.4rem 0.625rem 0.3rem;
      font-size: 0.8125rem;
    }

    .theme-desktop {
      display: block;
    }

    .menu-open {
      display: none;
    }
  }
</style>
