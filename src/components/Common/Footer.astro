---
import { footerI18n, navI18n } from "../../i18n/components";
import { LEGAL_PAGES, legalLinksI18n } from "../../i18n/pages/legal";
import { LINES } from "../../utils/lines";
import { SERVICE_PAGES, type Lang } from "../../utils/routing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = footerI18n[lang];
const n = navI18n[lang];
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: n.blog, href: `/${lang}/blog/` },
  { label: n.work, href: `/${lang}/work/` },
  { label: n.services, href: SERVICE_PAGES[0][lang]! },
  { label: n.newsletter, href: `/${lang}/newsletter/` },
  { label: n.about, href: `/${lang}/about/` },
];
---

<footer class="site-footer">
  <div class="strip" aria-hidden="true">
    {LINES.map((line) => <span style={`background:${line.color}`} />)}
  </div>

  <div class="wrapper">
    <div class="top">
      <div class="about">
        <a href={`/${lang}/`} class="brand">Antonio Bermúdez</a>
        <p>{t.tagline}</p>
      </div>

      <nav aria-label={t.navigate}>
        <p class="kicker">{t.navigate}</p>
        <ul>{navLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>

      <nav aria-label={t.lines}>
        <p class="kicker">{t.lines}</p>
        <ul>
          {
            LINES.map((line) => (
              <li>
                <a href={`/${lang}/blog/?linea=${line.id}`}>
                  <span class="dot" style={`background:${line.color}`} />
                  {line.code} · {line.label[lang]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="kicker">{t.follow}</p>
        <ul>
          <li><a href="https://github.com/TempooDev" rel="me">GitHub ↗</a></li>
          <li><a href="https://www.linkedin.com/in/antoniobermudezr/" rel="me">LinkedIn ↗</a></li>
          <li><a href={`/${lang}/rss.xml`}>RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <nav class="legal" aria-label={legalLinksI18n[lang].label}>
        <span class="mono">&copy; {currentYear} {t.copyright}</span>
        {LEGAL_PAGES.map((page) => <a href={`/${lang}/${page}/`}>{legalLinksI18n[lang][page]}</a>)}
      </nav>
      <a class="mono analytics" href="https://tempooanalytics.eu/">{t.analytics}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: 4rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: 8px;
  }

  .top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 1.5rem;
    padding-block: 3rem 2.5rem;
  }

  .about {
    grid-column: 1 / -1;
  }

  .brand {
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--ink);
    text-decoration: none;
  }

  .about p {
    margin-top: 0.5rem;
    max-width: 24rem;
    line-height: 1.5;
  }

  .kicker {
    margin-bottom: 0.875rem;
    font-size: 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 0.5rem;
    border-radius: 50%;
    vertical-align: -1px;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--sep);
    font-size: 0.8125rem;
  }

  .legal {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .legal a,
  .analytics {
    color: var(--ink-2);
  }

  @media (min-width: 50em) {
    .top {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }

    .about {
      grid-column: auto;
    }

    .bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .legal {
      flex-direction: row;
      gap: 1.5rem;
    }
  }
</style>
