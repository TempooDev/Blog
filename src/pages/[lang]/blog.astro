---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LineChip from "@components/Lines/LineChip.astro";
import { getLangStaticPaths, type Lang } from "../../utils/routing";
import { LINES, formatDate, toStations } from "../../utils/lines";
import { blogI18n } from "../../i18n/pages/collections";

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Lang;
const t = blogI18n[lang];

const stations = toStations(
  await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`)),
);

// One list on a single vertical track, newest first, with a year marker
// every time the year changes. Lines are only colored dots and filters.
type Row = { kind: "year"; year: number } | { kind: "station"; station: (typeof stations)[number] };
const rows: Row[] = [];
let lastYear: number | undefined;
for (const station of stations) {
  if (station.year && station.year !== lastYear) {
    rows.push({ kind: "year", year: station.year });
    lastYear = station.year;
  }
  rows.push({ kind: "station", station });
}

const usedLines = new Set(stations.flatMap((s) => s.post.data.lines));
---

<BaseLayout title={t.metaTitle} description={t.tagline}>
  <main class="wrapper blog">
    <header class="head">
      <p class="kicker">
        {stations.length} {t.stations} · {t.fixedLines} · {t.order}
      </p>
      <h1>{t.heading}</h1>
      <p class="sr-only">{t.tagline}</p>

      <div class="filters" role="group" aria-label={t.filters}>
        <button type="button" class="filter all" aria-pressed="true" data-line="">
          {t.all}
        </button>
        {
          LINES.map((line) => (
            <button
              type="button"
              class="filter"
              aria-pressed="false"
              data-line={line.id}
              disabled={!usedLines.has(line.id)}
            >
              <LineChip line={line} lang={lang} />
            </button>
          ))
        }
      </div>
    </header>

    <ol class="track">
      {
        rows.map((row) =>
          row.kind === "year" ? (
            <li class="year" data-year={row.year}>
              <span>{row.year}</span>
            </li>
          ) : (
            <li
              class="station"
              data-lines={row.station.post.data.lines.join(" ")}
              data-year={row.station.year}
            >
              <span class="dots" aria-hidden="true">
                {row.station.lines.map((l) => (
                  <span style={`background:${l.color}`} />
                ))}
              </span>
              <span
                class:list={[
                  "stop",
                  { transfer: row.station.lines.length > 1, plain: row.station.lines.length === 0 },
                ]}
                style={row.station.lines.length === 1 ? `--line:${row.station.lines[0].color}` : undefined}
                aria-hidden="true"
              />
              <article>
                <p class="kicker">
                  {t.station} {row.station.number}
                  {row.station.post.data.publishDate && (
                    <>
                      {" · "}
                      <time datetime={row.station.post.data.publishDate.toISOString()}>
                        {formatDate(row.station.post.data.publishDate, lang)}
                      </time>
                    </>
                  )}
                </p>
                <h2>
                  <a href={row.station.href}>{row.station.post.data.title}</a>
                </h2>
                <p class="desc">{row.station.post.data.description}</p>
                <p class="meta">
                  {row.station.lines.map((l) => (
                    <>
                      <LineChip line={l} lang={lang} size="sm" class="chip-desktop" />
                      <LineChip line={l} lang={lang} badgeOnly size="sm" class="chip-mobile" />
                    </>
                  ))}
                  {row.station.post.data.minutes && (
                    <span class="mono">
                      {row.station.post.data.minutes} {t.minutes}
                    </span>
                  )}
                  {row.station.post.data.tags.length > 0 && (
                    <span class="mono tags">{row.station.post.data.tags.join("  ·  ")}</span>
                  )}
                </p>
              </article>
            </li>
          ),
        )
      }
    </ol>
    <p class="empty" hidden>{t.noResults}</p>
  </main>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".filters .filter")];
  const allBtn = buttons.find((b) => !b.dataset.line)!;
  const stations = [...document.querySelectorAll<HTMLElement>(".track .station")];
  const years = [...document.querySelectorAll<HTMLElement>(".track .year")];
  const empty = document.querySelector<HTMLElement>(".blog .empty")!;
  const selected = new Set<string>();

  const apply = () => {
    allBtn.setAttribute("aria-pressed", String(selected.size === 0));
    for (const b of buttons) {
      if (b.dataset.line) b.setAttribute("aria-pressed", String(selected.has(b.dataset.line)));
    }
    const visibleYears = new Set<string>();
    let visible = 0;
    for (const s of stations) {
      const lines = (s.dataset.lines || "").split(" ").filter(Boolean);
      const show = selected.size === 0 || lines.some((l) => selected.has(l));
      s.hidden = !show;
      if (show) {
        visible++;
        if (s.dataset.year) visibleYears.add(s.dataset.year);
      }
    }
    for (const y of years) y.hidden = !visibleYears.has(y.dataset.year!);
    empty.hidden = visible > 0;

    const url = new URL(location.href);
    if (selected.size) url.searchParams.set("linea", [...selected].join(","));
    else url.searchParams.delete("linea");
    history.replaceState(null, "", url);
  };

  for (const b of buttons) {
    b.addEventListener("click", () => {
      const line = b.dataset.line;
      if (!line) selected.clear();
      else if (selected.has(line)) selected.delete(line);
      else selected.add(line);
      apply();
    });
  }

  // Footer links open the blog already filtered: /blog/?linea=ia
  const initial = new URL(location.href).searchParams.get("linea");
  if (initial) {
    for (const id of initial.split(",")) {
      if (buttons.some((b) => b.dataset.line === id && !b.disabled)) selected.add(id);
    }
    apply();
  }
</script>

<style>
  .blog {
    padding-bottom: 2rem;
  }

  .head {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--sep);
  }

  .head .kicker {
    font-size: 0.75rem;
  }

  .head h1 {
    margin-top: 0.5rem;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    /* On phones the chips scroll sideways instead of wrapping */
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 0.25rem;
    scrollbar-width: none;
  }

  .filter {
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .filter.all {
    padding: 0.55rem 1rem 0.45rem;
    border: 1px solid var(--sep);
    background: var(--surface);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .filter.all[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
  }

  .filter :global(.chip) {
    padding-block: 0.35rem;
  }

  /* Selected line: filled with its color */
  .filter[aria-pressed="true"] :global(.chip) {
    border-color: var(--line);
    background: var(--line);
    color: #fff;
  }

  .filter[aria-pressed="true"] :global(.chip .badge) {
    background: rgba(255, 255, 255, 0.28);
  }

  .filter[aria-pressed="true"] :global(.chip)::after {
    content: "✓";
  }

  /* Disabled: no stations on that line in this language yet */
  .filter:disabled {
    cursor: default;
  }

  .filter:disabled :global(.chip) {
    opacity: 0.4;
    border-style: dashed;
    border-color: var(--ink-2);
  }

  /* --- The track --------------------------------------------------------- */
  .track {
    --x: 12px; /* center of the track inside the list */
    --content: 3rem; /* where the text starts */
    position: relative;
    list-style: none;
    padding: 2.5rem 0 1rem;
  }

  .track::before {
    content: "";
    position: absolute;
    left: calc(var(--x) - var(--track) / 2);
    top: 1.75rem;
    bottom: 2rem;
    width: var(--track);
    border-radius: 4px;
    background: var(--ink);
  }

  .station {
    position: relative;
    padding-left: var(--content);
  }

  .station + .station {
    margin-top: 2.25rem;
  }

  .year + .station {
    margin-top: 1.25rem;
  }

  .station + .year {
    margin-top: 2.5rem;
  }

  .year {
    position: relative;
    height: 1.5rem;
  }

  .year span {
    position: absolute;
    left: var(--x);
    transform: translateX(-50%);
    padding: 0.3rem 0.5rem 0.2rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .stop {
    --r: 11px;
    position: absolute;
    left: calc(var(--x) - var(--r));
    top: calc(1.35rem + 0.85rem - var(--r));
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    border-radius: 50%;
    border: 4px solid var(--line, var(--ink));
    background: var(--bg);
  }

  .stop.transfer {
    --r: 13px;
    border-color: var(--ink);
  }

  .stop.plain {
    --r: 9px;
  }

  .dots {
    display: none;
  }

  article .kicker {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  h2 {
    margin-top: 0.3rem;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .desc {
    display: none;
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .meta .tags {
    flex-basis: 100%;
  }

  .meta :global(.chip-desktop) {
    display: none;
  }

  .empty {
    padding: 1rem 0 2rem;
    color: var(--ink-2);
  }

  @media (min-width: 60em) {
    .filters {
      flex-wrap: wrap;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .track {
      --x: 120px;
      --content: 168px;
    }

    .station + .station {
      margin-top: 2.75rem;
    }

    .stop {
      --r: 12px;
      top: calc(1.6rem + 1.15rem - var(--r));
    }

    .stop.transfer {
      --r: 15px;
    }

    .dots {
      position: absolute;
      left: calc(var(--x) - 48px);
      top: calc(1.6rem + 1.15rem - 8px);
      display: flex;
      flex-direction: row-reverse;
      gap: 6px;
      transform: translateX(-100%);
      transform: translateX(calc(-100% + 16px));
    }

    .dots span {
      width: 16px;
      height: 16px;
      border-radius: 50%;
    }

    article .kicker {
      font-size: 0.75rem;
    }

    h2 {
      font-size: 2rem;
      line-height: 1.15;
      letter-spacing: -0.015em;
    }

    .desc {
      display: block;
    }

    .meta {
      gap: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }

    .meta .tags {
      flex-basis: auto;
    }

    .meta :global(.chip-desktop) {
      display: inline-flex;
    }

    .meta :global(.chip-mobile) {
      display: none;
    }
  }
</style>
