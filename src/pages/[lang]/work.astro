---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from "@components/Common/ContactCTA.astro";
import PortfolioPreview from "@components/Portfolio/PortfolioPreview.astro";
import Hero from "@components/Common/Hero.astro";
import Grid from "@components/Common/Grid.astro";
import { getLangStaticPaths } from "../../utils/routing";
import { byPublishDateDesc } from "../../utils/dates";
import { workI18n } from "../../i18n/pages/collections";
import { getWorkServiceLink, similarQuestion } from "../../i18n/pages/services";

export const getStaticPaths = getLangStaticPaths;

const { lang } = Astro.params;

const projects = (
  await getCollection("work", ({ id }) => {
    return id.startsWith(`${lang}/`);
  })
).sort(byPublishDateDesc);

const content = workI18n[lang as keyof typeof workI18n];
const similar = similarQuestion[lang as "es" | "en"];
---

<BaseLayout title={content.title} description={content.description}>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title={content.heroTitle}
        tagline={content.heroTagline}
        align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => {
            const service = getWorkServiceLink(project.id);
            return (
              <li>
                <PortfolioPreview project={project} />
                {service && (
                  <p class="similar">
                    {similar}{" "}
                    <a
                      href={service.href}
                      data-tempoo-goal="ver_servicio"
                      data-tempoo-goal-pagina={Astro.url.pathname}
                      data-tempoo-goal-destino={service.href}
                      data-tempoo-goal-posicion="work"
                    >{service.label}</a>
                  </p>
                )}
              </li>
            );
          })
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .similar {
    margin-top: 0.75rem;
    color: var(--gray-200);
  }

  .similar a {
    color: var(--accent-regular);
  }
</style>
