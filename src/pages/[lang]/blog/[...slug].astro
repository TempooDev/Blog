---
import { type CollectionEntry, getCollection } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import LineChip from "../../../components/Lines/LineChip.astro";
import Comments from "../../../components/Comments";
import NewsletterSignup from "../../../components/NewsletterSignup";
import { demoteHeadings } from "../../../utils/seo";
import { TERMINALS, formatDate, neighbours, terminalHref, toStations, type Station } from "../../../utils/lines";
import type { Lang } from "../../../utils/routing";
import { blogI18n } from "../../../i18n/pages/collections";
import { articleServiceLinks } from "../../../i18n/pages/services";

interface Props {
  entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((entry) => {
    // Expected entry.id format: "lang/slug"
    const [lang, ...slugParts] = entry.id.split("/");
    return {
      params: { lang, slug: slugParts.join("/") },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = blogI18n[lang];
const serviceLink = articleServiceLinks[entry.id];

const stations = toStations(
  await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`)),
);
const current = stations.find((s) => s.post.id === entry.id)!;
const [primary, secondary] = current.lines;

// Neighbours on the main line; a post without lines just follows publication order.
const chrono = [...stations].reverse(); // oldest first
const i = chrono.findIndex((s) => s.post.id === entry.id);
const { prev, next } = primary
  ? neighbours(stations, current, primary.id)
  : { prev: chrono[i - 1], next: chrono[i + 1] };

const terminalOf = (lineId: string | undefined) => TERMINALS.find((term) => term.line === lineId);
const primaryTerminal = !next ? terminalOf(primary?.id) : undefined;

const transfer = secondary
  ? (() => {
      const after = neighbours(stations, current, secondary.id).next;
      const term = terminalOf(secondary.id);
      return after
        ? { line: secondary, title: after.post.data.title, href: after.href, sub: `${t.station} ${after.number}` }
        : term
          ? { line: secondary, title: `${t.terminal}: ${term.name}`, href: terminalHref(term, lang), sub: t.endOfLine }
          : undefined;
    })()
  : undefined;

const html = demoteHeadings(entry.rendered?.html || entry.body || "");
// Table of contents from the article's h2 (Astro already gives them an id).
const toc = [...html.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map(([, id, inner]) => ({
  id,
  text: inner.replace(/<[^>]+>/g, "").trim(),
}));

const lineColor = primary?.color ?? "var(--ink)";
const date = entry.data.publishDate;

const railStations: { s: Station | undefined; role: "prev" | "current" | "next" }[] = [
  { s: prev, role: "prev" },
  { s: current, role: "current" },
  { s: next, role: "next" },
];
const roleLabel = { prev: t.previous, current: t.here, next: t.next };
---

<BaseLayout title={entry.data.title} description={entry.data.description} entry={entry}>
  <div
    class="post wrapper"
    style={`--line:${lineColor}`}
    data-tempoo-scroll="blog_post_content"
    data-tempoo-scroll-threshold="0.5"
    data-tempoo-scroll-delay="200"
  >
    <!-- Mobile: the line as a strip with the previous and next stations -->
    <nav class="strip" aria-label={primary ? `${t.line} ${primary.code}` : t.allLines}>
      <p class="kicker">{primary ? `${t.line} ${primary.code} · ${primary.label[lang]}` : t.allLines}</p>
      <div class="strip-track">
        {prev ? <a class="strip-stop prev" href={prev.href}>← {prev.number}</a> : <span class="strip-stop prev" />}
        <span class="strip-stop current">{current.number} · {t.here}</span>
        {next ? <a class="strip-stop next" href={next.href}>{next.number} →</a> : <span class="strip-stop next" />}
      </div>
    </nav>

    <a class="back" href={`/${lang}/blog/`}>← {t.allLines}</a>

    <header class="head">
      <div class="labels">
        {current.lines.map((line) => <LineChip line={line} lang={lang} />)}
        {entry.data.tags.length > 0 && <span class="mono tags">{entry.data.tags.join("  ·  ")}</span>}
      </div>
      <p class="kicker">{t.station} {current.number}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="lead">{entry.data.description}</p>}
      <p class="mono meta">
        {date && <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>}
        {date && entry.data.minutes && "  ·  "}
        {entry.data.minutes && `${entry.data.minutes} ${t.readingTime}`}
      </p>
    </header>

    <aside class="rail">
      <nav aria-label={primary ? `${t.line} ${primary.code}` : t.allLines}>
        <p class="kicker rail-title">{primary ? `${t.line} ${primary.code} · ${primary.label[lang]}` : t.allLines}</p>
        <ol class="rail-track">
          {
            railStations.map(({ s, role }) =>
              s ? (
                <li class:list={[role, { transfer: s.lines.length > 1 }]}>
                  {role === "current" ? (
                    <span class="rail-link" aria-current="page">
                      <span class="kicker">{roleLabel[role]} · {s.number}</span>
                      <span class="rail-name">{s.post.data.title}</span>
                    </span>
                  ) : (
                    <a class="rail-link" href={s.href}>
                      <span class="kicker">{roleLabel[role]} · {s.number}</span>
                      <span class="rail-name">{s.post.data.title}</span>
                    </a>
                  )}
                </li>
              ) : null,
            )
          }
        </ol>
        {
          secondary && (
            <p class="rail-transfer">
              <span>{t.transferHere}</span>
              <LineChip line={secondary} lang={lang} size="sm" />
            </p>
          )
        }
      </nav>

      {
        toc.length > 1 && (
          <nav class="toc" aria-label={t.toc}>
            <p class="kicker">{t.toc}</p>
            <ol>
              {toc.map(({ id, text }) => (
                <li><a href={`#${id}`}>{text}</a></li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>

    <main class="body">
      {
        entry.data.img && (
          <figure class="cover">
            <img
              src={entry.data.img}
              alt={entry.data.img_alt || entry.data.title}
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="mono">
              {t.figure} 1 · {entry.data.img_alt || entry.data.title}
            </figcaption>
          </figure>
        )
      }

      <div class="content" set:html={html} />

      {
        serviceLink && (
          <p class="service">
            <strong>{serviceLink.question}</strong>{" "}
            <a
              href={serviceLink.href}
              data-tempoo-goal="ver_servicio"
              data-tempoo-goal-pagina={Astro.url.pathname}
              data-tempoo-goal-destino={serviceLink.href}
              data-tempoo-goal-posicion="articulo"
            >
              {serviceLink.label}
            </a>
          </p>
        )
      }

      <div class="ends">
        {
          next ? (
            <a class="end" href={next.href} style={`--line:${lineColor}`}>
              <span class="kicker">{t.nextStation}</span>
              <span class="end-sub">
                {primary && <LineChip line={primary} lang={lang} badgeOnly size="sm" />}
                <span class="mono">
                  {t.station} {next.number}
                  {next.post.data.publishDate && ` · ${formatDate(next.post.data.publishDate, lang)}`}
                </span>
              </span>
              <span class="end-title">{next.post.data.title}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ) : primaryTerminal ? (
            <a class="end" href={terminalHref(primaryTerminal, lang)} style={`--line:${lineColor}`}>
              <span class="kicker">{t.nextStation}</span>
              <span class="end-sub">
                <LineChip line={primary!} lang={lang} badgeOnly size="sm" />
                <span class="mono">{t.endOfLine}</span>
              </span>
              <span class="end-title">{t.terminal}: {primaryTerminal.name}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ) : null
        }
        {
          transfer && (
            <a class="end transfer" href={transfer.href} style={`--line:${transfer.line.color}`}>
              <span class="kicker">
                {t.transferTo} {transfer.line.code} {transfer.line.label[lang]}
              </span>
              <span class="end-sub">
                <LineChip line={transfer.line} lang={lang} badgeOnly size="sm" />
                <span class="mono">{transfer.sub}</span>
              </span>
              <span class="end-title">{transfer.title}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>

      <NewsletterSignup client:visible lang={lang} />
      <Comments client:visible slug={entry.data.translationId} lang={lang} />
    </main>
  </div>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "strip" "head" "body";
    padding-bottom: 2rem;
  }

  .strip {
    grid-area: strip;
    margin: calc(clamp(1.75rem, 3.5vw, 3rem) * -1) calc(var(--gutter) * -1) 1.75rem;
    padding: 0.875rem var(--gutter) 0.75rem;
    border-bottom: 1px solid var(--sep);
    background: var(--surface);
  }

  .strip .kicker {
    color: var(--line);
    font-size: 0.625rem;
  }

  .strip-track {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    height: 3.5rem;
    margin-top: 0.25rem;
  }

  .strip-track::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 1rem;
    height: var(--track);
    margin-top: calc(var(--track) / -2);
    border-radius: 4px;
    background: var(--line);
  }

  .strip-stop {
    position: relative;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .strip-stop.next {
    text-align: right;
  }

  .strip-stop.current {
    color: var(--ink);
    text-align: center;
  }

  .strip-stop::before {
    content: "";
    position: absolute;
    top: calc(-2.5rem + 1rem - 10px);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 4px solid var(--ink);
    background: var(--bg);
  }

  .strip-stop.prev::before {
    left: 18px;
  }

  .strip-stop.next::before {
    right: 18px;
  }

  .strip-stop.current::before {
    left: 50%;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    top: calc(-2.5rem + 1rem - 14px);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--line) 22%, transparent);
  }

  span.strip-stop.prev::before,
  span.strip-stop.next::before {
    display: none;
  }

  .back {
    display: none;
  }

  .head {
    grid-area: head;
  }

  .labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.625rem;
    margin-bottom: 1rem;
  }

  .tags {
    flex-basis: 100%;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .head .kicker {
    font-size: 0.75rem;
  }

  .head h1 {
    margin-top: 0.375rem;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.25rem);
    letter-spacing: -0.02em;
  }

  .lead {
    margin-top: 1rem;
    max-width: 50rem;
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 0.875rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--sep);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .rail {
    display: none;
  }

  .body {
    grid-area: body;
    min-width: 0;
    max-width: var(--measure);
    padding-top: 1.75rem;
  }

  .cover {
    margin-bottom: 2rem;
  }

  .cover img {
    display: block;
    width: 100%;
    border-radius: 6px;
    background: var(--board);
  }

  .cover figcaption {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  /* --- Article body ------------------------------------------------------- */
  .content {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .content > :global(* + *) {
    margin-top: 1.1em;
  }

  .content :global(h2) {
    margin-top: 2.2em;
    font-size: 1.5rem;
    scroll-margin-top: 1.5rem;
  }

  .content :global(h3) {
    margin-top: 1.8em;
    font-size: 1.25rem;
  }

  .content :global(h2 + *),
  .content :global(h3 + *) {
    margin-top: 0.6em;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25em;
  }

  .content :global(li + li) {
    margin-top: 0.35em;
  }

  .content :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
  }

  .content :global(img) {
    border-radius: 6px;
  }

  .content :global(blockquote) {
    padding-left: 1.5rem;
    border-left: 6px solid var(--line);
    font-weight: 600;
    font-size: 1.3125rem;
    line-height: 1.35;
  }

  .content :global(hr) {
    border: 0;
    border-top: 1px solid var(--sep);
  }

  /* Wide diagrams scroll instead of shrinking until the labels are unreadable */
  .content :global(.mermaid) {
    overflow-x: auto;
  }

  .content :global(.mermaid svg) {
    max-width: none;
  }

  :global(.theme-dark) .content :global(.mermaid) {
    color-scheme: dark;
  }

  .service {
    margin-top: 2rem;
  }

  /* --- Next station / transfer -------------------------------------------- */
  .ends {
    display: grid;
    gap: 1rem;
    margin-block: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--sep);
  }

  .end {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 3.5rem 1.25rem 1.5rem;
    border: 1px solid var(--sep);
    border-left: 6px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .end:hover {
    border-color: var(--ink);
    border-left-color: var(--line);
  }

  .end .kicker {
    font-size: 0.6875rem;
  }

  .end.transfer .kicker {
    color: var(--line);
  }

  .end-sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .end-title {
    font-weight: 700;
    font-size: 1.3125rem;
    line-height: 1.25;
  }

  .arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.1rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .body > :global(.newsletter-signup) {
    margin-bottom: 3rem;
  }

  /* --- Desktop -------------------------------------------------------------- */
  @media (min-width: 60em) {
    .post {
      grid-template-columns: 13.75rem minmax(0, var(--measure)) 1fr;
      grid-template-areas:
        "back head head"
        "rail body .";
      column-gap: 5rem;
      padding-bottom: 3rem;
    }

    .strip {
      display: none;
    }

    .back {
      grid-area: back;
      display: block;
      align-self: start;
      color: var(--ink-2);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
    }

    .back:hover {
      color: var(--ink);
    }

    .head {
      padding-top: 2.5rem;
      max-width: 55rem;
    }

    .tags {
      flex-basis: auto;
      margin-left: 0.5rem;
      font-size: 0.8125rem;
    }

    .meta {
      max-width: var(--measure);
      padding-bottom: 2rem;
    }

    .rail {
      grid-area: rail;
      display: block;
      padding-top: 2.75rem;
    }

    .rail > * {
      position: sticky;
      top: 2rem;
    }

    .rail-title {
      color: var(--line);
      font-size: 0.6875rem;
    }

    .rail-track {
      --x: 1rem;
      position: relative;
      list-style: none;
      padding: 1.75rem 0 1rem;
    }

    .rail-track::before {
      content: "";
      position: absolute;
      left: calc(var(--x) - var(--track) / 2);
      top: 0.75rem;
      bottom: 0;
      width: var(--track);
      border-radius: 4px;
      background: var(--line);
    }

    .rail-track li {
      position: relative;
      padding-left: 2.75rem;
    }

    .rail-track li + li {
      margin-top: 2.25rem;
    }

    .rail-track li::before {
      content: "";
      position: absolute;
      left: calc(var(--x) - 11px);
      top: 0.9rem;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 4px solid var(--line);
      background: var(--bg);
    }

    .rail-track li.transfer::before {
      border-color: var(--ink);
    }

    .rail-track li.current::before {
      left: calc(var(--x) - 15px);
      top: 0.7rem;
      width: 30px;
      height: 30px;
      border-color: var(--ink);
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--line) 22%, transparent);
    }

    .rail-link {
      display: grid;
      gap: 0.2rem;
      color: var(--ink-2);
      text-decoration: none;
    }

    a.rail-link:hover .rail-name {
      color: var(--ink);
      text-decoration: underline;
    }

    .rail-link .kicker {
      font-size: 0.6875rem;
    }

    .rail-name {
      font-size: 0.875rem;
      line-height: 1.35;
    }

    .current .rail-link,
    .current .rail-link .kicker {
      color: var(--ink);
    }

    .current .rail-name {
      font-weight: 700;
      font-size: 0.9375rem;
    }

    .rail-transfer {
      display: grid;
      justify-items: start;
      gap: 0.5rem;
      margin-top: 1.25rem;
      font-size: 0.8125rem;
      color: var(--ink-2);
    }

    .toc {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--sep);
    }

    .toc .kicker {
      font-size: 0.6875rem;
    }

    .toc ol {
      list-style: none;
      padding: 0;
      margin-top: 0.75rem;
      display: grid;
      gap: 0.5rem;
    }

    .toc a {
      color: var(--ink-2);
      font-size: 0.875rem;
      line-height: 1.35;
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--ink);
      text-decoration: underline;
    }

    .body {
      padding-top: 2.75rem;
    }

    .content {
      font-size: 1.125rem;
    }

    .content :global(h2) {
      font-size: 1.875rem;
    }

    .content :global(blockquote) {
      font-size: 1.625rem;
    }

    .ends {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
</style>
