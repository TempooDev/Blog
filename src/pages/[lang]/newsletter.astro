---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "@components/Common/Hero.astro";
import Grid from "@components/Common/Grid.astro";
import CardPreview from "@components/Common/CardPreview.astro";
import NewsletterSignup from "../../components/NewsletterSignup";
import { getLangStaticPaths } from "../../utils/routing";
import { newsletterI18n } from "../../i18n/pages/collections";

export const getStaticPaths = getLangStaticPaths;

const { lang } = Astro.params;

const issues = (
  await getCollection("newsletter", ({ id }) => id.startsWith(`${lang}/`))
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const content = newsletterI18n[lang as keyof typeof newsletterI18n];
---

<BaseLayout title={content.metaTitle} description={content.tagline}>
  <div class="stack gap-20">
    <main class="wrapper stack gap-10">
      <Hero title={content.title} tagline={content.tagline} align="start" />
      <div class="signup">
        <NewsletterSignup client:load lang={lang} showStatus />
      </div>
      <section class="stack gap-8">
        <h2 class="archive-title">{content.archiveTitle}</h2>
        {
          issues.length === 0 ? (
            <p class="empty">{content.empty}</p>
          ) : (
            <Grid>
              {issues.map((issue) => (
                <li>
                  <CardPreview
                    title={issue.data.title}
                    description={issue.data.description}
                    href={`/${issue.id.split("/")[0]}/newsletter/${issue.id.split("/").slice(1).join("/")}/`}
                    imgSrc={issue.data.img}
                    imgAlt={issue.data.img_alt || issue.data.title}
                    tags={issue.data.tags}
                    publishDate={issue.data.publishDate.toISOString().split("T")[0]}
                  />
                </li>
              ))}
            </Grid>
          )
        }
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .signup {
    max-width: 48rem;
  }

  .archive-title {
    font-size: var(--text-2xl);
  }

  .empty {
    color: var(--gray-400);
  }
</style>
