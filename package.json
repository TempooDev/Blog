    "@astrojs/sitemap": "^3.7.4",
    "@directus/sdk": "^25.0.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/hast": "^3.0.4",
    "@types/lodash": "^4.17.23",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "lodash": "^4.17.23",
    "playwright": "^1.58.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype": "^13.0.2",
    "sitemap": "9.0.0",
