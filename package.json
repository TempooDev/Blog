{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "directus:snapshot": "podman exec blog_directus_1 node cli.js schema snapshot /directus/extensions/schema.yaml --yes && podman cp blog_directus_1:/directus/extensions/schema.yaml ./directus-schema.yaml",
    "directus:apply": "podman cp ./directus-schema.yaml blog_directus_1:/directus/extensions/schema.yaml && podman exec blog_directus_1 node cli.js schema apply /directus/extensions/schema.yaml --yes"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
